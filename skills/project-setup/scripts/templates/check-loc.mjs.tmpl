#!/usr/bin/env node
/* Generated by project-setup. Ratchets per-file nonblank LOC vs scripts/loc-baseline.json.
 * Files <= maxLoc are fine; grandfathered hotspots may shrink but not grow.
 * `--update` rewrites the baseline from the current state (use at adoption). */
import { readdirSync, readFileSync, realpathSync, statSync, writeFileSync, existsSync } from 'node:fs';
import { isAbsolute, join, relative, sep } from 'node:path';

const ROOT = process.cwd();
const BASELINE = join(ROOT, 'scripts', 'loc-baseline.json');
const MAX_LOC = {{locCap}};
const SRC = join(ROOT, '{{srcDir}}'); // source root derived from the detected entry
// The canonical source root, so the walker can reject a symlink that resolves to an
// ANCESTOR of it (which would climb out of src/ and scan siblings). Falls back to SRC
// when it doesn't exist yet (nothing to walk then anyway).
const SRC_REAL = (() => { try { return realpathSync(SRC); } catch { return SRC; } })();
const EXT = /\.({{locExts}})$/;
const IGNORE_DIRS = new Set(['node_modules', 'dist', 'coverage', '.git', '.fallow', '.project-setup-backup']);
const update = process.argv.includes('--update');

function walk(dir, out = [], stack = new Set()) {
  // statSync FOLLOWS symlinks, so a symlinked SOURCE FILE stays counted and an acyclic
  // symlinked source dir is still walked — only cyclic, broken, and ancestor links are
  // dropped. Initial apply runs this with --update, so it must never abort or climb out
  // of the source root.
  let real;
  try {
    real = realpathSync(dir);
  } catch {
    return out; // missing dir, or a broken link target
  }
  // A link to an ANCESTOR of the scan root (e.g. src/up -> ..) resolves to a dir that
  // CONTAINS src; descending it would climb out of the source root and scan unrelated
  // siblings. `real` strictly contains SRC iff relative(real, SRC) is a non-empty DOWNWARD
  // path — compared by `..` path SEGMENT (not string prefix, so a dir literally named
  // `..src` isn't mistaken for `../`) and not an absolute cross-volume result.
  const rel = relative(real, SRC_REAL);
  if (rel !== '' && rel !== '..' && !rel.startsWith('..' + sep) && !isAbsolute(rel)) return out;
  // `stack` is the ACTIVE traversal path (not a global visited set): a real dir already
  // on the current branch is a cycle -> stop. A real dir and an acyclic alias to it are
  // NOT on each other's active path, so BOTH are walked and recorded — the baseline
  // stays stable regardless of readdir order or later alias removal. Backtrack on exit.
  if (stack.has(real)) return out;
  stack.add(real);
  for (const entry of readdirSync(dir, { withFileTypes: true })) {
    if (IGNORE_DIRS.has(entry.name)) continue;
    const abs = join(dir, entry.name);
    let st;
    try {
      st = statSync(abs); // follow the link; a broken/cyclic one throws here
    } catch {
      continue;
    }
    if (st.isDirectory()) walk(abs, out, stack);
    else if (st.isFile() && EXT.test(entry.name)) out.push(abs);
  }
  stack.delete(real); // leave the active path so a sibling alias to this dir still counts
  return out;
}
const loc = (abs) => readFileSync(abs, 'utf8').split('\n').filter((l) => l.trim() !== '').length;
const toPosix = (p) => p.split(sep).join('/');

const current = {};
for (const abs of walk(SRC)) {
  const n = loc(abs);
  if (n > MAX_LOC) current[toPosix(relative(ROOT, abs))] = n;
}

if (update) {
  writeFileSync(BASELINE, JSON.stringify({ maxLoc: MAX_LOC, files: current }, null, 2) + '\n');
  console.log(`Updated ${toPosix(relative(ROOT, BASELINE))} (${Object.keys(current).length} grandfathered).`);
  process.exit(0);
}
const baseline = existsSync(BASELINE) ? JSON.parse(readFileSync(BASELINE, 'utf8')) : { files: {} };
const fails = [];
for (const [file, n] of Object.entries(current)) {
  const base = baseline.files[file];
  if (base === undefined) fails.push(`  ${file}: ${n} > ${MAX_LOC} (new oversized file)`);
  else if (n > base) fails.push(`  ${file}: ${n} (baseline ${base})`);
}
if (fails.length) {
  console.error('LOC guard FAILED:\n' + fails.join('\n') + '\n\nSplit the file, or run `node scripts/check-loc.mjs --update` for a reviewed bump.');
  process.exit(1);
}
console.log('LOC guard OK.');
